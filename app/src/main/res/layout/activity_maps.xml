<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:id="@+id/vwSwitch">
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20dip"
            android:text="Traffic Map"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/screen1Label"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        <Button
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Return"
            android:textSize="15dip"
            android:backgroundTint="#0057a4"
            android:layout_gravity="center"
            android:id="@+id/returnButton"
            android:textColor="#FFFFFF"
            />
        <Button
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="Map Options"
        android:textSize="15dip"
        android:backgroundTint="#0057a4"
        android:layout_gravity="center"
        android:id="@+id/screen1Button"
            android:textColor="#FFFFFF"
        />
        <Button
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Filter"
            android:textSize="15dip"
            android:backgroundTint="#0057a4"
            android:layout_gravity="center"
            android:id="@+id/filterButton"
            android:textColor="#FFFFFF"
            />
        </LinearLayout>
        <fragment xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:tools="http://schemas.android.com/tools"
            xmlns:map="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/map"
            tools:context="myandroidstuff.me.org.mapflipperexample.MapsFlipperActivity"
            android:name="com.google.android.gms.maps.SupportMapFragment"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20dip"
            android:text="Map Options Screen"
            android:layout_gravity="center"
            android:id="@+id/screen2Label"
            />
        <TextView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Select the map Type"
            android:layout_gravity="center"
            />
        <RadioGroup
            android:id="@+id/mapTypeGroup"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">
            <RadioButton
                android:text="Normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/normalViewRadio"
                />
            <RadioButton
                android:text="Terrain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/terrainViewRadio"
                />
            <RadioButton
                android:text="Satellite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/satelliteViewRadio"
                />
            <RadioButton
                android:text="Hybrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hybridViewRadio"
                />
        </RadioGroup>
        <CheckBox
            android:id="@+id/panZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pan/Zoom"
            />
        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20dip"
            android:text="Return to Map"
            android:layout_gravity="center"
            android:id="@+id/screen2Button"
            android:backgroundTint="#0057a4"
            android:textColor="#FFFFFF"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter by Situation"
            android:textSize="20dp"
            android:layout_gravity="center"
            android:padding="12dp"/>
        <CheckBox
            android:id="@+id/filterMaintenance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maintenance Works"
            android:checked="true"/>
        <CheckBox
            android:id="@+id/filterLaneManagement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Road/Carriageway/Lane Management"
            android:checked="true"/>
        <CheckBox
            android:id="@+id/filterAccident"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accident"
            android:checked="true"/>
        <CheckBox
            android:id="@+id/filterTraffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abormal Traffic"
            android:checked="true"/>
        <CheckBox
            android:id="@+id/filterVehicleObs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Obstruction"
            android:checked="true"/>
        <CheckBox
            android:id="@+id/filterObstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Obstruction"
            android:checked="true"/>
        <Button
            android:id="@+id/applyFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply Filters"
            android:backgroundTint="#0057a4"
            android:textColor="#FFFFFF"/>
    </LinearLayout>
</ViewFlipper>