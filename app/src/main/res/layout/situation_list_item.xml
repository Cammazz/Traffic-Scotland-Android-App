<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/SituationRow"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:padding="14dp">

    <ImageView android:id="@+id/situationIcon" android:layout_width="50dp" android:layout_height="50dp"
        android:scaleType="centerInside" android:contentDescription="Situation Icon"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="#f5f4f4">

        <TextView android:id="@+id/situationType" android:layout_height="wrap_content" android:layout_width="match_parent"
            android:text="Situation Type" android:textStyle="bold" android:textSize="15sp"/>
        <TextView android:id="@+id/situationDesc" android:layout_height="wrap_content" android:layout_width="match_parent"
            android:text="Situation Description" android:textStyle="bold" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/situationChevron" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">"
        android:textColor="#0057a4" android:textSize="35sp" android:textStyle="bold" android:paddingStart="8dp" android:paddingEnd="4dp"/>
</LinearLayout>