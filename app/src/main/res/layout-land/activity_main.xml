<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">
    <TextView android:id="@+id/salutation" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle = "bold" android:gravity = "center" android:text="Traffic Scotland"/>
    <TextView android:id="@+id/acknowledgement" android:layout_width="fill_parent" android:layout_height="wrap_content" android:textSize="10sp" android:gravity = "center" android:text="Contains Traffic Scotland data"/>
    <TextView android:id="@+id/updateTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Last Updated: --:--  |  Next Update: --:--" android:textSize="12sp" android:gravity="center"/>
    <EditText android:id="@+id/roadSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="🔎︎ Search by Road (e.g. M8, A7)" android:inputType="text" android:gravity="center" android:padding="10dp" android:layout_marginTop="6dp" android:layout_marginBottom="6dp"/>

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight = "1"
    android:orientation="horizontal">
        <ListView android:id="@+id/situationList" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4" android:dividerHeight="1dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight = "0.85" android:layout_margin="4dp" android:backgroundTint="#0057a4" android:text="Refresh Data"/>
        <Button android:id="@+id/mapButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight = "0.85" android:layout_margin="4dp" android:backgroundTint="#0057a4" android:text="Map View"/>
        <Button android:id="@+id/nearbyButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.85" android:text="Nearby" android:backgroundTint="#2196F3"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>